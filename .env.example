# Copy this file to .env and fill in your real keys. Never commit .env.

OPENAI_API_KEY=sk-your-openai-key-here
PINECONE_API_KEY=pcsk-your-pinecone-key-here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SUPPORT_CHANNEL_ID=your-slack-channel-id-here

# Optional: if set, /diagnose requires a matching X-API-Key header.
# Leave unset for local dev; set it once deployed somewhere public.
API_SHARED_SECRET=